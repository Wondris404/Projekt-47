; Engine configuration file.
; Godot 4.7 — Projekt-47 economic simulator

config_version=5

[application]
boot_splash/bg_color=Color(0.02, 0.02, 0.04, 1)
boot_splash/image="res://assets/ui/logo.png"
boot_splash/fullsize=false
config/icon="res://assets/ui/icon.png"
config/windows_native_icon="res://assets/ui/icon.ico"

config/name="Projekt-47"
config/description="Lokálny ekonomický a geopolitický simulátor. Spravil vývojár Wondris404."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EconMath="*res://scripts/autoload/EconMath.gd"
DataLoader="*res://scripts/autoload/DataLoader.gd"
GameState="*res://scripts/autoload/GameState.gd"
TimeSystem="*res://scripts/autoload/TimeSystem.gd"
MarketSystem="*res://scripts/autoload/MarketSystem.gd"
BankingSystem="*res://scripts/autoload/BankingSystem.gd"
SovereignLoans="*res://scripts/autoload/SovereignLoans.gd"
IndustrySystem="*res://scripts/autoload/IndustrySystem.gd"
GeopoliticsSystem="*res://scripts/autoload/GeopoliticsSystem.gd"
AgentSystem="*res://scripts/autoload/AgentSystem.gd"
EventSystem="*res://scripts/autoload/EventSystem.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
LawSystem="*res://scripts/autoload/LawSystem.gd"
Difficulty="*res://scripts/autoload/Difficulty.gd"
TerrainSystem="*res://scripts/autoload/TerrainSystem.gd"
PoliticsSystem="*res://scripts/autoload/PoliticsSystem.gd"
RivalSystem="*res://scripts/autoload/RivalSystem.gd"
BankProducts="*res://scripts/autoload/BankProducts.gd"
StockMarket="*res://scripts/autoload/StockMarket.gd"
Empire="*res://scripts/autoload/Empire.gd"
Transport="*res://scripts/autoload/Transport.gd"
Brand="*res://scripts/autoload/Brand.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme_factorio.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[debug]

gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_signal=0
