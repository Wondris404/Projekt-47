[gd_resource type="Theme" load_steps=14 format=3]

; ============================================================================
; d01 "Šablóna – Neon" – UKÁŽKOVÝ dizajn na kopírovanie (pozri docs/DESIGNS.md).
; Skopíruj celý priečinok themes/d01 -> themes/dNN a uprav farby/štýly nižšie.
; Pravidlá: fonty len OFL/CC0 (súbor v themes/dNN/fonts/ + licencia, zápis v LICENSES.md),
; žiadne cesty mimo themes/dNN/ okrem zdieľaných fontov z assets/fonts/.
; Kľúče [resource] zodpovedajú ui/theme_p47.tres (súčasný dizajn, gfx kolo 2) – pokry aspoň tie.
; ============================================================================

; Font: zdieľaný NotoSans (OFL) z repa, cez FontVariation (hrubší + širší rozostup).
; Vlastný font: [ext_resource type="FontFile" path="res://themes/dNN/fonts/Meno.ttf" id="1_font"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSans-Regular.ttf" id="1_font"]

[sub_resource type="FontVariation" id="FontVariation_main"]
base_font = ExtResource("1_font")
variation_embolden = 0.45
spacing_glyph = 1

; --- Tlačidlá: normal / hover / pressed / disabled / focus -------------------
[sub_resource type="StyleBoxFlat" id="Btn_normal"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.09, 0.05, 0.17, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.0, 0.85, 0.95, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0.0, 0.85, 0.95, 0.25)
shadow_size = 6

[sub_resource type="StyleBoxFlat" id="Btn_hover"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.22, 0.05, 0.3, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1.0, 0.2, 0.75, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(1.0, 0.2, 0.75, 0.45)
shadow_size = 10

[sub_resource type="StyleBoxFlat" id="Btn_pressed"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(1.0, 0.2, 0.75, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1.0, 0.85, 0.95, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="Btn_disabled"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
bg_color = Color(0.08, 0.07, 0.11, 0.8)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.3, 0.4, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxEmpty" id="Btn_focus"]

; --- Panely, karty, polia, tooltip ------------------------------------------
[sub_resource type="StyleBoxFlat" id="Panel_main"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 10.0
bg_color = Color(0.05, 0.03, 0.11, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1.0, 0.2, 0.75, 0.85)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
shadow_color = Color(1.0, 0.2, 0.75, 0.25)
shadow_size = 12

[sub_resource type="StyleBoxFlat" id="Field"]
content_margin_left = 8.0
