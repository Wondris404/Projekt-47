corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxEmpty" id="Empty"]

[sub_resource type="StyleBoxFlat" id="Grabber"]
bg_color = Color(0.0, 0.85, 0.95, 0.7)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[resource]
default_font = SubResource("FontVariation_main")
default_font_size = 16
Button/colors/font_color = Color(0.85, 0.97, 1, 1)
Button/colors/font_disabled_color = Color(0.5, 0.5, 0.6, 1)
Button/colors/font_hover_color = Color(1, 0.85, 0.97, 1)
Button/colors/font_pressed_color = Color(0.05, 0.02, 0.1, 1)
Button/styles/disabled = SubResource("Btn_disabled")
Button/styles/focus = SubResource("Btn_focus")
Button/styles/hover = SubResource("Btn_hover")
Button/styles/normal = SubResource("Btn_normal")
Button/styles/pressed = SubResource("Btn_pressed")
Button/constants/h_separation = 6
HeaderLabel/base_type = &"Label"
HeaderLabel/colors/font_color = Color(0, 0.9, 1, 1)
HeaderLabel/font_sizes/font_size = 18
HeaderLabel/colors/font_outline_color = Color(0.4, 0, 0.3, 0.8)
HeaderLabel/constants/outline_size = 4
Label/colors/font_color = Color(0.88, 0.9, 1, 1)
LineEdit/colors/font_color = Color(0.85, 0.97, 1, 1)
LineEdit/styles/normal = SubResource("Field")
OptionButton/colors/font_color = Color(0.85, 0.97, 1, 1)
BoxContainer/constants/separation = 8
VBoxContainer/constants/separation = 8
HBoxContainer/constants/separation = 8
PanelContainer/styles/panel = SubResource("Panel_main")
Panel/styles/panel = SubResource("Panel_main")
ScrollContainer/styles/panel = SubResource("Empty")
SpinBox/colors/font_color = Color(0.85, 0.97, 1, 1)
SpinBox/styles/normal = SubResource("Field")
TabContainer/styles/tab_selected = SubResource("Tab_sel")
TabContainer/styles/tab_unselected = SubResource("Tab_unsel")
TooltipLabel/colors/font_color = Color(0.85, 0.97, 1, 1)
TooltipPanel/styles/panel = SubResource("Tooltip")
VScrollBar/styles/grabber = SubResource("Grabber")
VScrollBar/styles/grabber_highlight = SubResource("Btn_pressed")
