const DEP_LABELS = [[10.0, "Žiadna"], [30.0, "Nízka"], [55.0, "Stredná"], [85.0, "Vysoká"], [101.0, "Úplná"]]

func dependency(iso: String) -> Dictionary:
	var w: Dictionary = GameState.world.get(iso, {})
	var gdp_eur = maxf(1.0, float(w.get("gdp_usd", DataLoader.countries.get(iso, {}).get("gdp_usd", 1e11))) / maxf(GameState.usd_per_eur, 0.1))
	var pop = maxf(1.0, float(w.get("population", DataLoader.countries.get(iso, {}).get("population", 1e6))))
	var rev = 0.0
	var emp = 0.0
	var out: Dictionary = {}
	for f in GameState.player_firms():
		if str(f.get("country", "")) != iso:
			continue
		var mh: Array = f.get("month_hist", [])
		rev += (float(mh[mh.size() - 1].get("rev", 0.0)) * 12.0) if mh.size() > 0 else 0.0
		emp += float(f.get("workers", 0.0))
		for fac in f.get("facilities", []):
			var rc: Dictionary = DataLoader.recipes.get(str(fac.get("recipe", "")), {})
			if rc.is_empty():
				continue
			var tp = IndustrySystem._throughput(f, fac, rc)
			for o in rc.get("outputs", {}).keys():
				out[o] = float(out.get(o, 0.0)) + float(rc.outputs[o]) * tp
	var res_rows: Array = []
	var res_share = 0.0
	for cid in out.keys():
		var bk: Dictionary = GameState.markets.get(iso, {}).get(cid, {})
		var dem = float(bk.get("last_dem", 0.0))
		var sh = clampf(float(out[cid]) / dem, 0.0, 1.0) if dem > 0.0 else 0.0
		res_rows.append({"cid": str(cid), "name": str(DataLoader.commodity(str(cid)).get("name", cid)), "qty": float(out[cid]), "share": sh})
		res_share = maxf(res_share, sh * (1.5 if DataLoader.commodity(str(cid)).get("category", "") == "energy" else 1.0))
	res_rows.sort_custom(func(a, b): return float(a.share) > float(b.share))
	var loans = 0.0
	for b in BankingSystem.player_banks():
		if str(b.get("country", "")) == iso:
			loans += BankProducts.cons_outstanding(b) + BankProducts.sum_p(b.get("mort_loans", [])) + BankProducts.sum_p(b.get("corp_loans", []))
	var infl = PoliticsSystem.influence(iso)
	var c_gdp = clampf((rev / gdp_eur) / 0.25, 0.0, 1.0)
	var c_res = clampf(res_share, 0.0, 1.0)
	var c_emp = clampf((emp / (pop * 0.5)) / 0.2, 0.0, 1.0)
	var c_loan = clampf((loans / gdp_eur) / 0.3, 0.0, 1.0)
	var c_inf = clampf(infl / 100.0, 0.0, 1.0)
	var owned = owns_state(iso)
	var idx = 100.0 if owned else clampf(c_gdp * 35.0 + c_res * 25.0 + c_emp * 15.0 + c_loan * 10.0 + c_inf * 15.0, 0.0, 100.0)
	return {"index": idx, "label": dep_label(idx), "gdp_share": rev / gdp_eur, "emp_share": emp / (pop * 0.5), "loans": loans, "loan_share": loans / gdp_eur,
		"influence": infl, "owned": owned, "resources": res_rows, "parts": {"HDP": c_gdp * 35.0, "Suroviny/energia": c_res * 25.0, "Zamestnanci": c_emp * 15.0, "Úvery": c_loan * 10.0, "Vplyv": c_inf * 15.0}}

func dep_label(idx: float) -> String:
	for l in DEP_LABELS:
		if idx < float(l[0]):
			return str(l[1])
	return "Úplná"

func dep_index(iso: String) -> float:
	return float(dependency(iso).index)

func dependency_text(iso: String) -> String:
	var d = dependency(iso)
	var t = "ZÁVISLOSŤ NA TEBE: %.0f/100 – %s%s\n" % [float(d.index), str(d.label), " (vlastníš tento štát)" if bool(d.owned) else ""]
	t += "• HDP vyrobené tvojimi firmami: %.2f %%\n• Tvoji zamestnanci: %.2f %% pracujúcich\n• Úvery tvojich bánk: %s (%.2f %% HDP)\n• Vplyv: %.0f\n" % [float(d.gdp_share) * 100.0, float(d.emp_share) * 100.0, EconMath.eur(float(d.loans)), float(d.loan_share) * 100.0, float(d.influence)]
	if (d.resources as Array).is_empty():
		t += "• Suroviny/služby od teba: žiadne\n"
	for r in (d.resources as Array).slice(0, 6):
		t += "• %s: %.1f/deň = %.1f %% spotreby krajiny\n" % [str(r.name), float(r.qty), float(r.share) * 100.0]
	var p: Dictionary = d.parts
	t += "Rozpad indexu: " + ", ".join(p.keys().map(func(k): return "%s %.0f" % [k, float(p[k])]))
	t += "\nVyššia závislosť = vyššia šanca lobingu a vymáhania dlhov (pri Úplnej ~100 %)."
	return t


# ===================== JUAN15: burzova firma (obchodnik s cennymi papiermi) =====================
const BROKER_RISK = [  # [kup pod priemerom, predaj nad priemerom, podiel kapitalu na obchod, sanca chybneho obchodu]
	{"name": "nízke", "buy": 0.90, "sell": 1.08, "pos": 0.05, "err": 0.01},
	{"name": "stredné", "buy": 0.93, "sell": 1.06, "pos": 0.10, "err": 0.03},
	{"name": "vysoké", "buy": 0.96, "sell": 1.04, "pos": 0.20, "err": 0.07}]
const BROKER_FEE_WEEK = 1500.0
const BROKER_FEE_RATE = 0.002

func broker(f: Dictionary) -> Dictionary:
	if typeof(f.get("broker")) != TYPE_DICTIONARY:
		f["broker"] = {}
	var b: Dictionary = f.broker
	var defs = {"on": true, "cap_pct": 0.5, "risk": 1, "own": {}, "cost": {}, "pl": 0.0, "fees": 0.0, "trades": 0, "log": []}
	for k in defs.keys():
		if not b.has(k):
			b[k] = defs[k]
	return b

func broker_held(t: String) -> float:
	var q = 0.0
	for f in GameState.player_firms():
		if str(f.get("industry", "")) == "stock_broker" and typeof(f.get("broker")) == TYPE_DICTIONARY:
			q += float(f.broker.get("own", {}).get(t, 0.0))
	return q

func _fin_held(t: String) -> bool:
	for d in st().fin.values():
		if float(d.get("own", {}).get(t, 0.0)) > 0.0:
			return true
	return false

func broker_value(f: Dictionary) -> float:
	var v = 0.0
	var b = broker(f)
	for t in b.own.keys():
		v += float(b.own[t]) * float(StockMarket.listing(str(t)).get("price", 0.0))
	return v

func _br_trade(f: Dictionary, t: String, qty: float, side: String) -> float:
	# obchod cez spolocny register hraca (StockMarket.ex().own), penaze ide z/do kasy firmy
	var cash0 = float(GameState.player.cash)
	var e = ""
	var delta = 0.0
	if side == "buy":
		var q = StockMarket.quote(t, qty, "buy")
		if float(q.get("total", 1e30)) > float(f.cash):
			return 0.0
		GameState.player.cash = float(q.total) + 1.0
		e = StockMarket.buy(t, qty)
		delta = float(q.total) + 1.0 - float(GameState.player.cash)
	else:
		GameState.player.cash = 0.0
		e = StockMarket.sell(t, qty)
		delta = float(GameState.player.cash)
	GameState.player.cash = cash0
	if e != "":
		return 0.0
	f.cash = float(f.cash) + (-delta if side == "buy" else delta)
	return delta

func broker_weekly(f: Dictionary) -> void:
	var b = broker(f)
	if not bool(b.on) or StockMarket.ex().list.is_empty():
		return
	var rk: Dictionary = BROKER_RISK[clampi(int(b.risk), 0, 2)]
	var turnover = 0.0
	var cap = maxf(0.0, float(f.cash) + broker_value(f)) * clampf(float(b.cap_pct), 0.0, 1.0)
	for row in StockMarket.listings():
		if not (str(row.kind) in ["nat", "rival"]) or str(row.get("in_corp", "")) != "":
			continue
		var t = str(row.ticker)
		var ma = _ma(row.hist, 8)
		if ma <= 0.0 or (row.hist as Array).size() < 4:
			continue
		var px = float(row.price)
		var held = float(b.own.get(t, 0.0))
		if held > 0.0 and px > ma * float(rk.sell):
			var got = _br_trade(f, t, held, "sell")
			if got > 0.0:
				var basis = float(b.cost.get(t, 0.0))
				b.pl = float(b.pl) + got - basis
				b.own.erase(t)
				b.cost.erase(t)
				b.trades = int(b.trades) + 1
				turnover += got
				_log(b.log, "predaj %s +%s (zisk %s)" % [t, EconMath.eur(got), EconMath.eur(got - basis)])
		elif held <= 0.0 and px < ma * float(rk.buy) and not _fin_held(t):
			var free = cap - broker_value(f)
			var spend = minf(free, cap * float(rk.pos))
			var qty = floorf(spend / (px * 1.01))
			if spend > 5000.0 and qty >= 1.0 and StockMarket.owned(t) + qty <= float(row.shares):
				var paid = _br_trade(f, t, qty, "buy")
				if paid > 0.0:
					b.own[t] = qty
					b.cost[t] = paid
					b.trades = int(b.trades) + 1
					turnover += paid
					_log(b.log, "nákup %s %.0f ks za %s (%.0f %% pod priemerom)" % [t, qty, EconMath.eur(paid), (1.0 - px / ma) * 100.0])
	var fee = BROKER_FEE_WEEK + turnover * BROKER_FEE_RATE
	f.cash = float(f.cash) + fee
	b.fees = float(b.fees) + fee
	b.pl = float(b.pl) + fee
	if GameState.rng.randf() < float(rk.err) and float(f.cash) > 0.0:
		var loss = float(f.cash) * GameState.rng.randf_range(0.01, 0.04)
		f.cash = float(f.cash) - loss
		b.pl = float(b.pl) - loss
		_log(b.log, "chybný obchod / zlý odhad trhu: strata %s" % EconMath.eur(loss))

func broker_text(f: Dictionary) -> String:
	var b = broker(f)
	var rk: Dictionary = BROKER_RISK[clampi(int(b.risk), 0, 2)]
	var unreal = broker_value(f)
	for t in b.cost.keys():
		unreal -= float(b.cost[t])
	var out = "BURZA / OBCHODNÍK: %s · kapitál na obchody %d %% · riziko %s\n" % ["zapnutý" if bool(b.on) else "vypnutý", int(float(b.cap_pct) * 100.0), str(rk.name)]
	out += "Realizovaný zisk/strata (vrátane poplatkov) %s · poplatky %s · nerealizovaný %s · obchodov %d\n" % [EconMath.eur(float(b.pl)), EconMath.eur(float(b.fees)), EconMath.eur(unreal), int(b.trades)]
	out += "Kupuje akcie pod 8-týždňovým priemerom, predáva nad ním. Vyššie riziko = väčšie pozície a častejšie chyby.\nDRŽÍ:\n"
	var rows: Array = []
	for t in b.own.keys():
		var row = StockMarket.listing(str(t))
		rows.append([str(t), str(row.get("name", "")), float(b.own[t]), float(b.own[t]) * float(row.get("price", 0.0)), float(b.cost.get(t, 0.0))])
	rows.sort_custom(func(x, y): return float(x[3]) > float(y[3]))
	if rows.is_empty():
		out += "• nič (čaká na podhodnotené akcie)\n"
	for r in rows.slice(0, 10):
		out += "• %s %s: %.0f ks = %s (nákup %s)\n" % [r[0], r[1], r[2], EconMath.eur(r[3]), EconMath.eur(r[4])]
	for lg in (b.log as Array).slice(0, 4):
		out += "  · %s\n" % str(lg)
	return out

# ===================== JUAN15: odberatelia (kto kupuje od hraca) =====================
var _pf_day = -1
var _pf: Dictionary = {}

func _player_firm_map() -> Dictionary:
	if _pf_day != GameState.day_index:
		_pf_day = GameState.day_index
		_pf = {}
		for f in GameState.player_firms():
			_pf[str(f.id)] = f
	return _pf

func record_sales(iso: String, cid: String, offers_list: Array, bids_list: Array, npc_dem: float, dem: float, sell_fill: float, px: float) -> void:
	var pm = _player_firm_map()
	if pm.is_empty() or dem <= 0.0:
		return
	var sold_by_corp = {}
	for o in offers_list:
		var fid = str(o.actor).split(":")[0]
		if pm.has(fid) and Brand.VEHICLES.has(cid):
			Brand.track(fid, cid, float(o.qty) * sell_fill, iso)  # JUAN21
		if pm.has(fid):
			var corp = str(pm[fid].get("corp", ""))
			sold_by_corp[corp] = float(sold_by_corp.get(corp, 0.0)) + float(o.qty) * sell_fill
	if sold_by_corp.is_empty():
		return
	var buyers = [{"name": "Domácnosti a štát", "q": npc_dem}]
	var bl = bids_list.duplicate()
	bl.sort_custom(func(a, b): return float(a.qty) > float(b.qty))
	var rest = 0.0
	for i in bl.size():
		var bid_fid = str(bl[i].actor).split(":")[0]
		if i < 5:
			var bf = pm.get(bid_fid, {})
			if bf.is_empty():
				bf = GameState.firm_by_id(bid_fid)
			var nm = str(bf.get("name", "Zahraničná firma"))
			if str(bf.get("owner", "")) == "player":
				nm += " (tvoja)"
			buyers.append({"name": nm, "q": float(bl[i].qty)})
		else:
			rest += float(bl[i].qty)
	if rest > 0.0:
		buyers.append({"name": "Ostatné firmy", "q": rest})
	var c: Dictionary = st().cust
	for corp in sold_by_corp.keys():
		var sold = float(sold_by_corp[corp])
		for by in buyers:
			var q = sold * float(by.q) / dem
			if q <= 0.0:
				continue
			var k = "%s|%s|%s|%s" % [corp, iso, cid, str(by.name)]
			var row: Array = c.get(k, [0.0, 0.0])
			c[k] = [float(row[0]) + q, float(row[1]) + q * px]

func customers(corp_filter: String = "*", sort_by: String = "eur") -> Dictionary:
	var s = st()
	var src: Dictionary = s.cust_prev if not (s.cust_prev as Dictionary).is_empty() else s.cust
	var rows: Array = []
	var tot = 0.0
	for k in src.keys():
		var p = str(k).split("|")
		if p.size() < 4 or (corp_filter != "*" and p[0] != corp_filter):
			continue
		var v: Array = src[k]
		if float(v[1]) < 1.0:
			continue
		rows.append({"corp": p[0], "iso": p[1], "country": _name(p[1]), "good": str(DataLoader.commodity(p[2]).get("name", p[2])), "buyer": p[3], "qty": float(v[0]), "eur": float(v[1])})
		tot += float(v[1])
	match sort_by:
		"qty":
			rows.sort_custom(func(a, b): return float(a.qty) > float(b.qty))
		"country":
			rows.sort_custom(func(a, b): return str(a.country) < str(b.country) or (str(a.country) == str(b.country) and float(a.eur) > float(b.eur)))
		"good":
			rows.sort_custom(func(a, b): return str(a.good) < str(b.good) or (str(a.good) == str(b.good) and float(a.eur) > float(b.eur)))
		_:
			rows.sort_custom(func(a, b): return float(a.eur) > float(b.eur))
	var by_c = {}
	for r in rows:
		by_c[r.country] = float(by_c.get(r.country, 0.0)) + float(r.eur)
	return {"rows": rows, "total": tot, "countries": by_c, "full_month": not (s.cust_prev as Dictionary).is_empty()}


# JUAN17: mapovy mod Odberatelia - nakupy podla krajiny (iso)
func customers_by_iso() -> Dictionary:
	var s = st()
	var src: Dictionary = s.cust_prev if not (s.cust_prev as Dictionary).is_empty() else s.cust
	var out = {}
	for k in src.keys():
		var p = str(k).split("|")
		if p.size() < 4:
			continue
		var eur = float(src[k][1])
		if eur <= 0.0:
			continue
		if not out.has(p[1]):
			out[p[1]] = {"eur": 0.0, "goods": {}}
		out[p[1]].eur = float(out[p[1]].eur) + eur
		var g = str(DataLoader.commodity(p[2]).get("name", p[2]))
		out[p[1]].goods[g] = float(out[p[1]].goods.get(g, 0.0)) + eur
	return out
